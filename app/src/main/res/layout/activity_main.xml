<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Header App Bar / Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_api"
            app:tint="@color/primary"
            android:background="@drawable/ic_api"
            android:backgroundTint="@color/primary_container"
            android:padding="8dp"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_app"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_app"
                android:textSize="12sp"
                android:textColor="#64748B" />

        </LinearLayout>

    </LinearLayout>

    <!-- Section 1: Engines Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingBottom="12dp">

        <!-- OkHttp Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_okhttp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/okhttp_brand"
                    android:paddingBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOkHttpGet"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_get"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_get"
                    app:iconSize="16dp"
                    app:iconTint="@color/okhttp_brand" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOkHttpPost"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_post"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_post"
                    app:iconSize="16dp"
                    app:iconTint="@color/okhttp_brand" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Volley Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_volley"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/volley_brand"
                    android:paddingBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolleyGet"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_get"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_get"
                    app:iconSize="16dp"
                    app:iconTint="@color/volley_brand" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolleyPost"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_post"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_post"
                    app:iconSize="16dp"
                    app:iconTint="@color/volley_brand" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Section 2: Dynamic Status Banner Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#CBD5E1"
        app:cardBackgroundColor="@color/status_ready_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_api"
                app:tint="@color/status_ready_text"
                android:contentDescription="@string/status_ready" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:visibility="gone"
                android:indeterminateTint="@color/status_loading_text"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/status_ready"
                android:textColor="@color/status_ready_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLatency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="0 ms"
                android:textSize="11sp"
                android:textColor="#475569"
                android:background="#E2E8F0"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                tools:ignore="SmallSp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Section 3: Response Terminal Window -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResponse"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/code_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Terminal Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/code_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/response_header_title"
                    android:textColor="#9DA5B4"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopy"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/btn_copy"
                    android:textColor="#ABB2BF"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_copy"
                    app:iconSize="14dp"
                    app:iconTint="#ABB2BF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/btn_clear"
                    android:textColor="#E06C75"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_clear"
                    app:iconSize="14dp"
                    app:iconTint="#E06C75" />

            </LinearLayout>

            <!-- Terminal Code Output -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/response_placeholder"
                    android:textColor="@color/code_text"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </ScrollView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>